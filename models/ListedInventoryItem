const mongoose = require('mongoose');

const Schema = mongoose.Schema;

const InventorySchema = new Schema({
    item: {
        type: String,
        required: [true, 'Item name is required'],
        trim: true
    },
    brand: {
        type: String,
        trim: true
    },
    vendor: {
        type: String,
        trim: true
    },
    catalog: {
        type: String,
        trim: true
    },
    currentquantity: {
        type: Number,
        min: [0, 'Quantity cannot be negative'],
        default: 0
    },
    minimumquantity: {
        type: Number,
        min: [0, 'Minimum quantity cannot be negative'],
        default: 0
    },
    maximumquantity: {
        type: Number,
        min: [0, 'Maximum quantity cannot be negative'],
        default: 0
    },
    location: {
        type: String,
        trim: true
    },
    // Where the bulk / backstock of the item is kept
    storedLocations: [{
        type: String,
        trim: true
    }],
    // Where the item is stocked for point-of-use
    stockedInLocations: [{
        type: String,
        trim: true
    }],
    type: {
        type: String,
        trim: true
    },
    cost: {
        type: Number,
        min: [0, 'Cost cannot be negative'],
        default: 0
    },
    lastUsedDate: {
        type: Date,
        default: null
    },
    orderHistory: [{
        type: Date
    }],
    lastCycleCount: {
        type: Date,
        default: null
    },
    // Last time the item's details (not cycle counts / quantities) were
    // reviewed or confirmed as up to date. Drives the Update page.
    lastReviewedDate: {
        type: Date,
        default: null
    },
    cycleCountInterval: {
        type: Number,
        min: [1, 'Cycle count interval must be at least 1 day'],
        default: 90
    },
    orderFrequencyPeriod: {
        type: Number,
        min: [1, 'Order frequency period must be at least 1 day'],
        default: 30
    },
    useCycleCount: {
        type: Boolean,
        default: true
    },
    isActive: {
        type: Boolean,
        default: true
    },
    alternateItems: [{
        brand: { type: String, trim: true, default: '' },
        vendor: { type: String, trim: true, default: '' },
        catalogNumber: { type: String, trim: true, default: '' }
    }]
}, {
    timestamps: true
});

// Indexes for common queries
InventorySchema.index({ item: 1 });
InventorySchema.index({ vendor: 1 });
InventorySchema.index({ type: 1 });
InventorySchema.index({ isActive: 1 });

module.exports = mongoose.model('ListedInventoryItem', InventorySchema);