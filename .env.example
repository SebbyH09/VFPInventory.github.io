# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Node Environment (development or production)
NODE_ENV=development

# Server Port
PORT=8080

# Session Secret (use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-key-here-change-this-in-production

# MongoDB Connection URLs
# Development database (local MongoDB)
DATABASE_URL_DEV=mongodb://127.0.0.1/Inventory

# Production database (MongoDB Atlas or remote MongoDB)
# Example: mongodb+srv://username:password@cluster.mongodb.net/inventory?retryWrites=true&w=majority
DATABASE_URL=mongodb://your-production-mongodb-url-here

# Prendio PO Email Parser (Production only)
# Gmail account dedicated to receiving forwarded PO emails
PARSER_EMAIL=labinventory.parse@gmail.com
# Exact "From" address Prendio uses — check a real PO confirmation email
PRENDIO_EMAIL_SENDER=noreply@prendio.com

# Google OAuth2 Credentials (replaces App Password)
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Gmail API
# 3. Create OAuth2 credentials (Web application type)
# 4. Use https://developers.google.com/oauthplayground as a redirect URI
# 5. In the OAuth Playground, authorize the https://mail.google.com/ scope
#    to obtain a refresh token for your PARSER_EMAIL account
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Security Notes:
# 1. Never commit the .env file to version control
# 2. Use strong, unique SESSION_SECRET in production
# 3. Use environment-specific database URLs
# 4. Keep your .env file permissions restricted (chmod 600 .env)
