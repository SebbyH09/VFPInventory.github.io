
<head>
    <link rel="stylesheet" href="/dashboardstyle.css">
    <script defer src="/dashboard.js"></script>
</head>

<div class="dashboard-container">
    <div class="card-wrapper" id="ordersCardWrapper">
        <div class="card-header-controls">
            <h2 class="card-title">Recent Orders</h2>
        </div>
        <div class="cards-grid">
            <% if (recentOrders && recentOrders.length > 0) { %>
                <% recentOrders.forEach(order => { %>
                    <div class="card order-card clickable-card" data-order-id="<%= order._id %>"
                         data-order-number="<%= order.orderNumber %>"
                         data-order-items="<%= encodeURIComponent(JSON.stringify(order.items)) %>">
                        <div class="card-field">
                            <span class="field-label">Order #:</span>
                            <span class="field-value"><%= order.orderNumber %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Date:</span>
                            <span class="field-value"><%= new Date(order.createdAt).toLocaleDateString() %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Status:</span>
                            <span class="field-value">
                                <% if (order.status === 'open') { %>
                                    <span class="status-badge status-open">Open</span>
                                <% } else if (order.status === 'partial') { %>
                                    <span class="status-badge status-partial">Partial</span>
                                <% } else { %>
                                    <span class="status-badge status-received">Received</span>
                                <% } %>
                            </span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Items:</span>
                            <span class="field-value"><%= order.items.length %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Created By:</span>
                            <span class="field-value"><%= order.createdBy %></span>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">No orders in the past 14 days</div>
            <% } %>
        </div>
    </div>

    <% if (typeof lowStockAlertEnabled === 'undefined' || lowStockAlertEnabled) { %>
    <div class="card-wrapper" id="inventoryCardWrapper">
        <div class="card-header-controls">
            <h2 class="card-title">Need to Order</h2>
        </div>
        <div class="cards-grid">
            <% if (lowInventoryItems && lowInventoryItems.length > 0) { %>
                <% lowInventoryItems.forEach(item => { %>
                    <% const itemOrders = onOrderMap[item._id.toString()] || []; %>
                    <% const isOnOrder = itemOrders.length > 0; %>
                    <div class="card<%= isOnOrder ? ' on-order-card clickable-card' : '' %>"
                         data-item-id="<%= item._id %>"
                         data-item-name="<%= item.item %>"
                         data-item-brand="<%= item.brand || '' %>"
                         data-item-catalog="<%= item.catalog || '' %>"
                         data-item-quantity="<%= item.currentquantity %>"
                         data-item-min="<%= item.minimumquantity %>"
                         data-item-max="<%= item.maximumquantity || 0 %>"
                         data-item-cost="<%= (item.cost || 0) %>"
                         <% if (isOnOrder) { %>
                         data-order-details="<%= encodeURIComponent(JSON.stringify(itemOrders)) %>"
                         <% } %>>
                        <% if (isOnOrder) { %>
                            <div class="on-order-badge">On Order</div>
                        <% } %>
                        <div class="card-field">
                            <span class="field-label">Item:</span>
                            <span class="field-value"><%= item.item %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Brand:</span>
                            <span class="field-value"><%= item.brand || 'N/A' %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Catalog:</span>
                            <span class="field-value"><%= item.catalog || 'N/A' %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Current Qty:</span>
                            <span class="field-value quantity-low"><%= item.currentquantity %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Min Qty:</span>
                            <span class="field-value"><%= item.minimumquantity %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Max Qty:</span>
                            <span class="field-value"><%= item.maximumquantity || 'N/A' %></span>
                        </div>
                        <div class="card-actions-row">
                            <button class="card-action-btn card-add-order-btn" title="Add to Order Cart">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                Order
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">No items need to be ordered</div>
            <% } %>
        </div>
    </div>
    <% } %>

    <% if (typeof unlinkedLocationItems !== 'undefined' && unlinkedLocationItems && unlinkedLocationItems.length > 0) { %>
    <div class="card-wrapper" id="unlinkedLocationCardWrapper" style="grid-column: 1 / 3;">
        <div class="card-header-controls">
            <h2 class="card-title" style="color:#92400e;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" style="vertical-align:middle;margin-right:6px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Items in Locations Not Yet in Inventory
            </h2>
            <a href="/locations" style="font-size:13px;color:#3b82f6;text-decoration:none;font-weight:600;">Manage Locations →</a>
        </div>
        <div class="cards-grid">
            <% unlinkedLocationItems.forEach(function(item) { %>
                <div class="card" style="border-left:3px solid #f59e0b;">
                    <div class="card-field">
                        <span class="field-label">Item:</span>
                        <span class="field-value"><%= item.itemName %></span>
                    </div>
                    <div class="card-field">
                        <span class="field-label">Location:</span>
                        <span class="field-value"><%= item.locationName %></span>
                    </div>
                    <% if (item.specificLocation) { %>
                    <div class="card-field">
                        <span class="field-label">Spot:</span>
                        <span class="field-value"><%= item.specificLocation %></span>
                    </div>
                    <% } %>
                    <div class="card-actions-row">
                        <a href="/entry" class="card-action-btn" style="text-decoration:none;background:#3b82f6;color:white;border-color:#3b82f6;">+ Add to Inventory</a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    <% } %>

    <div class="card-wrapper cycle-count-wrapper" id="cycleCountCardWrapper">
        <div class="card-header-controls">
            <h2 class="card-title">Cycle Counts Due</h2>
            <div class="controls-group">
                <div class="display-limit-control">
                    <label for="cycleCountLimit">Show:</label>
                    <select id="cycleCountLimit">
                        <option value="5">5 items</option>
                        <option value="10" selected>10 items</option>
                        <option value="15">15 items</option>
                        <option value="20">20 items</option>
                        <option value="all">All items</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="cards-grid" id="cycleCountCardsContainer">
            <% if (cycleCountDueItems && cycleCountDueItems.length > 0) { %>
                <% cycleCountDueItems.forEach((item, index) => { %>
                    <div class="card cycle-count-card" data-index="<%= index %>" data-item-id="<%= item._id %>" data-current-qty="<%= item.currentquantity %>">
                        <div class="card-field">
                            <span class="field-label">Item:</span>
                            <span class="field-value"><%= item.item %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Brand:</span>
                            <span class="field-value"><%= item.brand || 'N/A' %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Last Count:</span>
                            <span class="field-value"><%= item.lastCycleCount ? new Date(item.lastCycleCount).toLocaleDateString() : 'Never' %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Days Since:</span>
                            <span class="field-value"><%= item.daysSinceCount !== null ? item.daysSinceCount : 'N/A' %></span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Interval:</span>
                            <span class="field-value"><%= item.cycleCountInterval || 90 %> days</span>
                        </div>
                        <div class="card-field">
                            <span class="field-label">Status:</span>
                            <span class="field-value">
                                <% if (!item.lastCycleCount) { %>
                                    <span class="status-badge status-overdue">Never Counted</span>
                                <% } else if (item.daysOverdue > 0) { %>
                                    <span class="status-badge status-overdue">Overdue by <%= item.daysOverdue %> days</span>
                                <% } else { %>
                                    <span class="status-badge status-due">Due Now</span>
                                <% } %>
                            </span>
                        </div>
                        <div class="card-action">
                            <button class="cycle-count-update-btn">
                                Update Count
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">No cycle counts due</div>
            <% } %>
        </div>
    </div>
</div>

<!-- On Order Details Modal -->
<div id="onOrderDetailsModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
        <span class="close on-order-modal-close">&times;</span>
        <h2>Order Details for <span id="onOrderItemName"></span></h2>
        <div class="modal-body">
            <table class="order-items-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Status</th>
                        <th>Ordered</th>
                        <th>Received</th>
                        <th>Remaining</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="onOrderDetailsBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Order Items Modal -->
<div id="orderItemsModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
        <span class="close order-modal-close">&times;</span>
        <h2>Order <span id="orderItemsModalNumber"></span></h2>
        <div class="modal-body">
            <table class="order-items-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Brand</th>
                        <th>Ordered</th>
                        <th>Received</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody id="orderItemsModalBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Cycle Count Update Modal -->
<div id="cycleCountModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Update Cycle Count</h2>
        <div class="modal-body">
            <p><strong>Item:</strong> <span id="modalItemName"></span></p>
            <div class="form-group">
                <label for="currentQty">Current Quantity:</label>
                <input type="number" id="currentQty" readonly>
            </div>
            <div class="form-group">
                <label for="updatedQty">Updated Quantity:</label>
                <input type="number" id="updatedQty" placeholder="Enter counted quantity" required>
            </div>
            <div class="modal-buttons">
                <button class="btn-submit">Submit</button>
                <button class="btn-cancel">Cancel</button>
            </div>
        </div>
    </div>
</div>
