<!DOCTYPE html>
<html>
<head>
    <title>Review Quote</title>
    <link rel="stylesheet" href="/quotes.css">
</head>
<body>
<%
    var exp = quote.expirationDate ? new Date(quote.expirationDate) : null;
    var expInput = exp ? exp.toISOString().slice(0,10) : '';
    var daysLeft = exp ? Math.ceil((exp - new Date()) / (1000*60*60*24)) : null;
%>
<div class="quotes-container" id="quoteDetail" data-quote-id="<%= quote._id %>">
    <div class="page-header">
        <div class="page-header-left">
            <a href="/quotes" class="back-link">← All quotes</a>
            <h1 class="page-title"><%= quote.vendor || 'Unknown vendor' %></h1>
            <p class="page-subtitle">
                <%= quote.fileName || 'Uploaded quote' %>
                <% if (quote.status === 'reviewed') { %>
                    <span class="status-badge status-reviewed">Reviewed</span>
                <% } else { %>
                    <span class="status-badge status-pending">Pending Review</span>
                <% } %>
            </p>
        </div>
    </div>

    <% if (quote.warnings && quote.warnings.length > 0) { %>
        <div class="quote-alert quote-alert-warn">
            <strong>Heads up — the parser wasn't sure about a few things:</strong>
            <ul>
                <% quote.warnings.forEach(function(w){ %><li><%= w %></li><% }); %>
            </ul>
        </div>
    <% } %>

    <!-- Editable quote header -->
    <div class="quote-header-card">
        <div class="qh-grid">
            <div class="form-group">
                <label>Vendor</label>
                <input type="text" id="qhVendor" value="<%= quote.vendor || '' %>">
            </div>
            <div class="form-group">
                <label>Quote #</label>
                <input type="text" id="qhNumber" value="<%= quote.quoteNumber || '' %>">
            </div>
            <div class="form-group">
                <label>Quote Date</label>
                <input type="text" id="qhDate" placeholder="YYYY-MM-DD" value="<%= quote.quoteDate || '' %>">
            </div>
            <div class="form-group">
                <label>Expiration Date
                    <% if (daysLeft !== null && daysLeft < 0) { %><span class="pill pill-red">Expired</span>
                    <% } else if (daysLeft !== null && daysLeft <= 30) { %><span class="pill pill-amber"><%= daysLeft %>d left</span><% } %>
                </label>
                <input type="date" id="qhExpiration" value="<%= expInput %>">
            </div>
        </div>
        <div class="qh-actions">
            <button class="btn-primary" id="saveHeaderBtn">Save Details</button>
            <span class="save-hint" id="headerSaveHint"></span>
        </div>
    </div>

    <h2 class="section-title">Line Items</h2>
    <p class="section-sub">Review each item, then tie it to an inventory item and approve it.</p>

    <div class="line-items">
        <% if (!quote.lineItems || quote.lineItems.length === 0) { %>
            <div class="empty-state"><p>No line items were detected in this quote.</p></div>
        <% } %>
        <% (quote.lineItems || []).forEach(function(li, idx) { %>
            <div class="line-item-card status-<%= li.approvalStatus %>" data-index="<%= idx %>">
                <div class="li-status-tag li-tag-<%= li.approvalStatus %>">
                    <%= li.approvalStatus.charAt(0).toUpperCase() + li.approvalStatus.slice(1) %>
                </div>

                <div class="li-fields">
                    <div class="form-group li-desc">
                        <label>Description</label>
                        <input type="text" class="li-input" data-field="description" value="<%= li.description || '' %>">
                    </div>
                    <div class="form-group">
                        <label>Catalog #</label>
                        <input type="text" class="li-input" data-field="catalogNumber" value="<%= li.catalogNumber || '' %>">
                    </div>
                    <div class="form-group li-narrow">
                        <label>Qty</label>
                        <input type="number" step="any" class="li-input" data-field="quantity" value="<%= li.quantity != null ? li.quantity : '' %>">
                    </div>
                    <div class="form-group li-narrow">
                        <label>Unit</label>
                        <input type="text" class="li-input" data-field="unit" value="<%= li.unit || '' %>">
                    </div>
                    <div class="form-group li-narrow">
                        <label>Quoted $</label>
                        <input type="number" step="0.01" class="li-input" data-field="quotedPrice" value="<%= li.quotedPrice != null ? li.quotedPrice : '' %>">
                    </div>
                    <div class="form-group li-narrow">
                        <label>Original $</label>
                        <input type="number" step="0.01" class="li-input" data-field="originalPrice" value="<%= li.originalPrice != null ? li.originalPrice : '' %>">
                    </div>
                </div>

                <div class="li-approve-row">
                    <div class="form-group li-select">
                        <label>Tie to inventory item</label>
                        <select class="li-inventory-select">
                            <option value="">— Select an item —</option>
                            <% inventoryItems.forEach(function(inv) {
                                var selected = String(li.inventoryItemId || '') === String(inv._id) ? 'selected' : '';
                            %>
                                <option value="<%= inv._id %>" data-cost="<%= inv.cost || 0 %>" <%= selected %>>
                                    <%= inv.item %><%= inv.catalog ? ' — ' + inv.catalog : '' %><%= inv.vendor ? ' (' + inv.vendor + ')' : '' %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="li-buttons">
                        <% if (li.approvalStatus === 'approved') { %>
                            <span class="li-linked-note">Linked to <strong><%= li.inventoryItemName || 'item' %></strong></span>
                            <button class="btn-mini li-reset-btn">Undo</button>
                        <% } else { %>
                            <button class="btn-primary btn-mini li-approve-btn">Approve &amp; Tie</button>
                            <% if (li.approvalStatus !== 'rejected') { %>
                                <button class="btn-mini li-reject-btn">Reject</button>
                            <% } else { %>
                                <button class="btn-mini li-reset-btn">Undo</button>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<script src="/quotes.js"></script>
</body>
</html>
