<!DOCTYPE html>
<html>
<head>
    <title>Inventory History</title>
    <link rel="stylesheet" href="/inventory.css">
    <link rel="stylesheet" href="/history.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
</head>
<body>
    <div class="inventory-container">
        <div class="table-controls">
            <h2>Inventory History</h2>
        </div>

        <!-- Filter Controls -->
        <div class="history-filters">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="startDate">Start Date:</label>
                    <input type="date" id="startDate" class="filter-input">
                </div>

                <div class="filter-group">
                    <label for="endDate">End Date:</label>
                    <input type="date" id="endDate" class="filter-input">
                </div>

                <div class="filter-group">
                    <label for="itemFilter">Item:</label>
                    <select id="itemFilter" class="filter-input">
                        <option value="all">All Items</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="changeTypeFilter">Change Type:</label>
                    <select id="changeTypeFilter" class="filter-input">
                        <option value="all">All Types</option>
                        <option value="quantity_change">Quantity Change</option>
                        <option value="quantity_consumed">Quantity Consumed</option>
                        <option value="item_used">Item Used</option>
                        <option value="order_placed">Order Placed</option>
                        <option value="cycle_count">Cycle Count</option>
                        <option value="item_created">Item Created</option>
                        <option value="item_updated">Item Updated</option>
                        <option value="item_deleted">Item Deleted</option>
                    </select>
                </div>

                <button id="applyFilters" class="filter-button">Apply Filters</button>
                <button id="resetFilters" class="filter-button secondary">Reset</button>
            </div>

            <div class="filter-row">
                <button id="showSummary" class="filter-button">Show Quantity Used Summary</button>
                <button id="generateReport" class="filter-button report-btn">Generate Report</button>
                <button id="openAnalytics" class="filter-button analytics-btn">Analytics Dashboard</button>
            </div>
        </div>

        <!-- Analytics Checkbox Panel -->
        <div id="analyticsPanel" class="analytics-panel hidden">
            <div class="analytics-panel-header">
                <h3>Select Metrics to Display</h3>
                <div class="analytics-panel-actions">
                    <button id="selectAllMetrics" class="filter-button secondary">Select All</button>
                    <button id="deselectAllMetrics" class="filter-button secondary">Deselect All</button>
                </div>
            </div>

            <div id="budgetInputGroup" class="budget-input-group hidden">
                <label for="monthlyBudget">Monthly Budget ($):</label>
                <input type="number" id="monthlyBudget" class="filter-input" value="0" min="0" step="100">
            </div>

            <div class="metrics-grid">
                <div class="metrics-category">
                    <h4>Spending Analytics</h4>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="monthlySpend">
                        <span>Monthly Spend</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="spendByCategory">
                        <span>Spend by Category</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="spendByVendor">
                        <span>Spend by Vendor/Brand</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="costPerUnit">
                        <span>Cost per Unit Consumed</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="budgetVsActual">
                        <span>Budget vs. Actual</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="spendTrend">
                        <span>Spend Trend Over Time</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="topSpendItems">
                        <span>Top Spend Items</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="reorderForecast">
                        <span>Reorder Cost Forecast</span>
                    </label>
                </div>

                <div class="metrics-category">
                    <h4>Inventory Metrics</h4>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="totalItems">
                        <span>Total Items</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="totalInventoryValue">
                        <span>Total Inventory Value</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="lowStockAlerts">
                        <span>Low Stock Alerts Count</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="belowReorderPoint">
                        <span>Items Below Reorder Point</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="stockOutCount">
                        <span>Stock-Out Count</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="turnoverRate">
                        <span>Inventory Turnover Rate</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="daysOfSupply">
                        <span>Days of Supply Remaining</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="quantityDeficit">
                        <span>Quantity Deficit</span>
                    </label>
                </div>

                <div class="metrics-category">
                    <h4>Consumption Metrics</h4>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="consumptionRate">
                        <span>Consumption Rate</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="topConsumed">
                        <span>Top Consumed Items</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="consumptionByUser">
                        <span>Consumption by User</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="usageTrends">
                        <span>Usage Trends</span>
                    </label>
                </div>

                <div class="metrics-category">
                    <h4>Cycle Count &amp; Compliance</h4>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="cycleCountCompliance">
                        <span>Cycle Count Compliance</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="cycleCountsCompleted">
                        <span>Cycle Counts Completed</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="accuracyRate">
                        <span>Inventory Accuracy Rate</span>
                    </label>
                    <label class="metric-checkbox">
                        <input type="checkbox" name="metric" value="avgReorderTime">
                        <span>Avg Time Between Reorders</span>
                    </label>
                </div>
            </div>

            <div class="analytics-generate-row">
                <button id="generateAnalytics" class="filter-button analytics-btn">Generate Dashboard</button>
            </div>
        </div>

        <!-- Summary Section -->
        <div id="summarySection" class="summary-section hidden">
            <h3>Quantity Used Summary</h3>
            <div id="summaryContent"></div>
        </div>

        <!-- Report Section -->
        <div id="reportSection" class="report-section hidden">
            <div class="report-header">
                <h3>Inventory Report</h3>
                <button id="closeReport" class="filter-button secondary report-close-btn">Close Report</button>
            </div>
            <div id="reportPeriod" class="report-period"></div>

            <!-- Summary Cards -->
            <div id="reportCards" class="report-cards"></div>

            <!-- Report Tabs -->
            <div class="report-tabs">
                <button class="report-tab active" data-tab="spendTab">Spend by Item</button>
                <button class="report-tab" data-tab="topConsumedTab">Top Consumed</button>
                <button class="report-tab" data-tab="activityTypeTab">Activity Breakdown</button>
                <button class="report-tab" data-tab="userActivityTab">User Activity</button>
                <button class="report-tab" data-tab="dailyTrendTab">Daily Trend</button>
            </div>

            <!-- Tab Content -->
            <div id="spendTab" class="report-tab-content active"></div>
            <div id="topConsumedTab" class="report-tab-content"></div>
            <div id="activityTypeTab" class="report-tab-content"></div>
            <div id="userActivityTab" class="report-tab-content"></div>
            <div id="dailyTrendTab" class="report-tab-content"></div>
        </div>

        <!-- History Table -->
        <div class="table-wrapper">
            <table id="historyTable">
                <thead>
                    <tr>
                        <th class="sortable" data-column="changeDate">
                            Date <span class="sort-indicator">&#9660;</span>
                        </th>
                        <th class="sortable" data-column="itemName">
                            Item <span class="sort-indicator"></span>
                        </th>
                        <th class="sortable" data-column="changeType">
                            Change Type <span class="sort-indicator"></span>
                        </th>
                        <th>Previous Qty</th>
                        <th>New Qty</th>
                        <th class="sortable" data-column="quantityChange">
                            Qty Change <span class="sort-indicator"></span>
                        </th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody">
                    <tr>
                        <td colspan="7" class="loading-message">Loading history data...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- No Data Message -->
        <div id="noDataMessage" class="no-data-message hidden">
            <p>No history records found for the selected filters.</p>
            <p>History tracking will begin recording changes from this point forward.</p>
        </div>
    </div>

    <!-- Analytics Modal -->
    <div id="analyticsModal" class="analytics-modal hidden">
        <div class="analytics-modal-content">
            <div class="analytics-modal-header">
                <h2>Analytics Dashboard</h2>
                <div class="analytics-modal-actions">
                    <button id="exportExcel" class="filter-button export-btn">Export to Excel</button>
                    <button id="closeAnalyticsModal" class="filter-button secondary">Close</button>
                </div>
            </div>
            <div id="analyticsModalBody" class="analytics-modal-body">
            </div>
        </div>
    </div>

    <script src="/history.js"></script>
</body>
</html>
