<!DOCTYPE html>
<html>
<head>
    <title>Inventory Items</title>
    <link rel="stylesheet" href="/inventory.css">
</head>
<body>
    <div class="inventory-container">
        <!-- Page Header -->
        <div class="page-header">
            <div class="page-header-left">
                <h1 class="page-title">Inventory Items</h1>
                <p class="page-subtitle">Manage consumable inventory stock</p>
            </div>
            <div class="page-header-right">
                <button id="newRowAdditionBtn" class="btn-add-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add Item
                </button>
                <button class="btn-notification" aria-label="Notifications">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                </button>
            </div>
        </div>

        <!-- Search and Stock Status Filters -->
        <div class="search-filter-row">
            <div class="search-bar-container">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" id="inventorySearchBar" placeholder="Search items, SKU, vendor...">
            </div>
            <div class="stock-status-filters">
                <button class="stock-filter-btn active" data-stock-filter="">All</button>
                <button class="stock-filter-btn" data-stock-filter="low">Low Stock</button>
                <button class="stock-filter-btn" data-stock-filter="out">Out Of Stock</button>
                <button class="stock-filter-btn" data-stock-filter="ok">In Stock</button>
                <button class="stock-filter-btn" data-stock-filter="inactive">Inactive</button>
            </div>
        </div>

        <!-- Category Filter Pills -->
        <div class="category-filter-bar">
            <button class="category-pill active" data-category="">All</button>
            <button class="category-pill" data-category="Reagent">Reagents</button>
            <button class="category-pill" data-category="Filter">Filters</button>
            <button class="category-pill" data-category="PPE">PPE</button>
            <button class="category-pill" data-category="Cleaning">Cleaning Supplies</button>
            <button class="category-pill" data-category="Office">Office Supplies</button>
            <button class="category-pill" data-category="Consumable">Lab Consumables</button>
            <button class="category-pill" data-category="Electrical">Electrical</button>
            <button class="category-pill" data-category="Mechanical">Mechanical Parts</button>
            <button class="category-pill" data-category="Other">Other</button>
        </div>

        <!-- Hidden select filters for JS compatibility -->
        <div style="display: none;">
            <select id="filterType" class="filter-select">
                <option value="">All</option>
                <option value="Reagent">Reagent</option>
                <option value="Filter">Filter</option>
                <option value="PPE">PPE</option>
                <option value="Cleaning">Cleaning Supplies</option>
                <option value="Office">Office Supplies</option>
                <option value="Consumable">Lab Consumables</option>
                <option value="Electrical">Electrical</option>
                <option value="Mechanical">Mechanical Parts</option>
                <option value="Other">Other</option>
            </select>
            <select id="filterLocation" class="filter-select">
                <option value="">All</option>
            </select>
            <select id="filterStock" class="filter-select">
                <option value="">All</option>
                <option value="out">Out of Stock</option>
                <option value="low">Low Stock</option>
                <option value="ok">In Stock</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        <!-- Data Table -->
        <div class="table-wrapper">
            <table id="mainTable1">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Item</th>
                        <th>Brand</th>
                        <th>Vendor</th>
                        <th>Catalog #</th>
                        <th>Current Quantity</th>
                        <th>Minimum Quantity</th>
                        <th>Max Quantity</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Cost per Unit</th>
                        <th>Days Since Last Use</th>
                        <th>Open Orders</th>
                        <th>Last Cycle Count</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (inventoryItems && inventoryItems.length > 0) { %>
                        <% inventoryItems.forEach((item, index) => { %>

                            <tr data-item-id="<%= item._id %>"
                                data-last-used="<%= item.lastUsedDate ? item.lastUsedDate.toISOString() : '' %>"
                                data-last-cycle-count="<%= item.lastCycleCount ? item.lastCycleCount.toISOString() : '' %>"
                                data-open-orders="<%= (orderCountMap && orderCountMap[item._id.toString()]) || 0 %>"
                                data-active="<%= item.isActive !== false %>"
                                class="<%= item.isActive === false ? 'inactive-row' : '' %>"
                                data-original='<%= JSON.stringify({
                                item: item.item,
                                brand: item.brand,
                                vendor: item.vendor,
                                catalogNumber: item.catalog,
                                currentQuantity: item.currentquantity,
                                minimumQuantity: item.minimumquantity,
                                maxQuantity: item.maximumquantity,
                                location: item.location,
                                type: item.type,
                                cost: item.cost || 0,
                                lastUsedDate: item.lastUsedDate,
                                lastCycleCount: item.lastCycleCount,
                                cycleCountInterval: item.cycleCountInterval || 90,
                                useCycleCount: item.useCycleCount !== undefined ? item.useCycleCount : true,
                                isActive: item.isActive !== false,
                                alternateItems: item.alternateItems || []
                            }) %>'>

                                <td class="row-number-cell">
                                    <span class="row-number"><%= index + 1 %></span>
                                </td>
                                <td><p class="inventoryitem"><%= item.item %></p></td>
                                <td><p class="inventoryitem"><%= item.brand %></p></td>
                                <td><p class="inventoryitem"><%= item.vendor %></p></td>
                                <td><p class="inventoryitem"><%= item.catalog %></p></td>
                                <td><p class="inventoryitem"><%= item.currentquantity %></p></td>
                                <td><p class="inventoryitem"><%= item.minimumquantity %></p></td>
                                <td><p class="inventoryitem"><%= item.maximumquantity %></p></td>
                                <td><p class="inventoryitem"><%= item.location || '' %></p></td>
                                <td><p class="inventoryitem"><%= item.type || '' %></p></td>
                                <td><p class="inventoryitem">$<%= (item.cost || 0).toFixed(2) %></p></td>
                                <td class="days-since-use"><p class="inventoryitem tracking-field">-</p></td>
                                <td class="order-frequency"><p class="inventoryitem tracking-field"><%= (orderCountMap && orderCountMap[item._id.toString()]) || 0 %></p></td>
                                <td class="last-cycle-count"><p class="inventoryitem tracking-field"><%= item.lastCycleCount ? new Date(item.lastCycleCount).toLocaleDateString() : 'Never' %></p></td>
                                <td class="status-cell">
                                    <span class="status-badge <%= item.isActive === false ? 'status-inactive' : 'status-active' %>">
                                        <%= item.isActive === false ? 'Inactive' : 'Active' %>
                                    </span>
                                </td>
                                <td class="actions-cell">
                                    <button class="delete-btn hidden">Delete</button>
                                    <button class="row-edit-btn">Edit</button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <!-- Empty state shown via CSS/JS -->
                    <% } %>
                </tbody>
            </table>

            <% if (!inventoryItems || inventoryItems.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#c0c0c0" stroke-width="1.5">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                </div>
                <h3 class="empty-state-title">No items found</h3>
                <p class="empty-state-text">Add your first inventory item to get started</p>
                <button class="btn-add-item-empty" id="emptyStateAddBtn">Add Item</button>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Add Item Modal -->
    <div id="addModal" class="edit-modal">
        <div class="edit-modal-content">
            <span class="close-modal">&times;</span>
            <h2>Add New Item</h2>
            <div class="edit-modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label for="addItem">Item: <span style="color: red;">*</span></label>
                        <input type="text" id="addItem" class="edit-input" required>
                    </div>
                    <div class="form-group">
                        <label for="addBrand">Brand:</label>
                        <input type="text" id="addBrand" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="addVendor">Vendor:</label>
                        <input type="text" id="addVendor" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="addCatalog">Catalog #:</label>
                        <input type="text" id="addCatalog" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="addCurrentQty">Current Quantity:</label>
                        <input type="number" id="addCurrentQty" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="addMinQty">Minimum Quantity:</label>
                        <input type="number" id="addMinQty" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="addMaxQty">Max Quantity:</label>
                        <input type="number" id="addMaxQty" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="addLocation">Location:</label>
                        <input type="text" id="addLocation" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="addType">Type:</label>
                        <select id="addType" class="edit-input">
                            <option value="">Select Type</option>
                            <option value="Reagent">Reagent</option>
                            <option value="Filter">Filter</option>
                            <option value="PPE">PPE</option>
                            <option value="Cleaning">Cleaning Supplies</option>
                            <option value="Office">Office Supplies</option>
                            <option value="Consumable">Lab Consumables</option>
                            <option value="Electrical">Electrical</option>
                            <option value="Mechanical">Mechanical Parts</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="addCost">Cost per Unit:</label>
                        <input type="number" id="addCost" class="edit-input" step="0.01" min="0" value="0">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="addCycleInterval">Cycle Interval (days):</label>
                        <input type="number" id="addCycleInterval" class="edit-input" value="90">
                    </div>
                    <div class="form-group">
                        <label style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="addUseCycleCount" checked>
                            <span>Use Cycle Count</span>
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="addAlternateItems">
                            <span>Alternate Items</span>
                        </label>
                    </div>
                </div>
                <div id="addAlternateItemsSection" class="alternate-items-section" style="display: none;">
                    <div id="addAlternateItemsContainer" class="alternate-items-container">
                    </div>
                    <button type="button" id="addAlternateItemBtn" class="add-alternate-btn">+ Add Alternate</button>
                </div>
                <div class="modal-buttons">
                    <button class="btn-submit">Add Item</button>
                    <button class="btn-cancel">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div id="editModal" class="edit-modal">
        <div class="edit-modal-content">
            <span class="close-modal">&times;</span>
            <h2>Edit Item</h2>
            <div class="edit-modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label for="editItem">Item:</label>
                        <input type="text" id="editItem" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="editBrand">Brand:</label>
                        <input type="text" id="editBrand" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="editVendor">Vendor:</label>
                        <input type="text" id="editVendor" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="editCatalog">Catalog #:</label>
                        <input type="text" id="editCatalog" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="editCurrentQty">Current Quantity:</label>
                        <input type="number" id="editCurrentQty" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="editMinQty">Minimum Quantity:</label>
                        <input type="number" id="editMinQty" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="editMaxQty">Max Quantity:</label>
                        <input type="number" id="editMaxQty" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label for="editLocation">Location:</label>
                        <input type="text" id="editLocation" class="edit-input">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="editType">Type:</label>
                        <select id="editType" class="edit-input">
                            <option value="">Select Type</option>
                            <option value="Reagent">Reagent</option>
                            <option value="Filter">Filter</option>
                            <option value="PPE">PPE</option>
                            <option value="Cleaning">Cleaning Supplies</option>
                            <option value="Office">Office Supplies</option>
                            <option value="Consumable">Lab Consumables</option>
                            <option value="Electrical">Electrical</option>
                            <option value="Mechanical">Mechanical Parts</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="editCost">Cost per Unit:</label>
                        <input type="number" id="editCost" class="edit-input" step="0.01" min="0">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="editCycleInterval">Cycle Interval (days):</label>
                        <input type="number" id="editCycleInterval" class="edit-input">
                    </div>
                    <div class="form-group">
                        <label style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="editUseCycleCount">
                            <span>Use Cycle Count</span>
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="editAlternateItems">
                            <span>Alternate Items</span>
                        </label>
                    </div>
                </div>
                <div id="editAlternateItemsSection" class="alternate-items-section" style="display: none;">
                    <div id="editAlternateItemsContainer" class="alternate-items-container">
                    </div>
                    <button type="button" id="editAlternateItemBtn" class="add-alternate-btn">+ Add Alternate</button>
                </div>
                <div class="modal-actions">
                    <button class="toggle-active-btn-modal">Mark Inactive</button>
                    <button class="delete-btn-modal">Delete</button>
                </div>
                <div class="modal-buttons">
                    <button class="btn-submit">Save Changes</button>
                    <button class="btn-cancel">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Item Modal (read-only) -->
    <div id="viewModal" class="edit-modal">
        <div class="edit-modal-content view-modal-content">
            <span class="close-modal" id="viewModalClose">&times;</span>
            <h2>Item Details</h2>
            <div class="view-modal-body">
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Item</span>
                        <span class="view-value" id="viewItem"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Brand</span>
                        <span class="view-value" id="viewBrand"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Vendor</span>
                        <span class="view-value" id="viewVendor"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Catalog #</span>
                        <span class="view-value" id="viewCatalog"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Current Quantity</span>
                        <span class="view-value" id="viewCurrentQty"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Minimum Quantity</span>
                        <span class="view-value" id="viewMinQty"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Max Quantity</span>
                        <span class="view-value" id="viewMaxQty"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Location</span>
                        <span class="view-value" id="viewLocation"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Type</span>
                        <span class="view-value" id="viewType"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Cost per Unit</span>
                        <span class="view-value" id="viewCost"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Days Since Last Use</span>
                        <span class="view-value" id="viewDaysSinceUse"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Open Orders</span>
                        <span class="view-value" id="viewOrderFrequency"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Last Cycle Count</span>
                        <span class="view-value" id="viewLastCycleCount"></span>
                    </div>
                    <div class="view-field">
                        <span class="view-label">Cycle Interval (days)</span>
                        <span class="view-value" id="viewCycleInterval"></span>
                    </div>
                </div>
                <div class="view-row">
                    <div class="view-field">
                        <span class="view-label">Status</span>
                        <span class="view-value" id="viewStatus"></span>
                    </div>
                </div>
                <div id="viewAlternateItemsSection" class="view-alternate-items-section" style="display: none;">
                    <h3 class="alternate-items-heading">Alternate Items</h3>
                    <div id="viewAlternateItemsContainer"></div>
                </div>
                <div class="modal-buttons">
                    <button class="btn-cancel" id="viewModalCloseBtn">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Load all scripts -->
    <script defer src="/editbutton.js"></script>
    <script defer src="/TableRowAdd.js"></script>
    <script defer src="/conditionalFormatting.js"></script>
    <script defer src="/inventoryTracking.js"></script>
    <script defer src="/editModal.js"></script>
    <script defer src="/searchBar.js"></script>
    <script defer src="/tableColumnControls.js"></script>
    <script defer src="/tableSorting.js"></script>
    <script src="/entryFilters.js"></script>
</body>
</html>
