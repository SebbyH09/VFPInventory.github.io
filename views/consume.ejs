<!DOCTYPE html>
<html>
<head>
    <title>Consume Inventory</title>
    <link rel="stylesheet" href="/consume.css">
</head>
<body>
    <div class="consume-container">
        <div class="consume-page-header">
            <div class="consume-page-header-left">
                <h1 class="page-title">Consume Inventory</h1>
                <p class="page-subtitle">Record items used or removed from stock</p>
            </div>
        </div>

        <!-- Mobile Tab Bar -->
        <div class="mobile-tabs">
            <button class="mobile-tab active" data-tab="inventory">Inventory</button>
            <button class="mobile-tab" data-tab="selected">Selected Items</button>
        </div>

        <div class="consume-layout">
            <!-- Left Side: Inventory List -->
            <div class="left-panel" data-panel="inventory">
                <h3 class="panel-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    Available Inventory
                </h3>
                <div class="search-section">
                    <input type="text" id="consumeSearchBar" placeholder="Search items, brand or catalog...">
                    <div class="search-buttons">
                        <button id="searchButton" class="search-btn">Search</button>
                        <button id="clearButton" class="clear-btn">Clear</button>
                    </div>
                </div>

                <div class="table-wrapper">
                    <table id="inventoryTable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Brand</th>
                                <th>Catalog #</th>
                                <th>Current Quantity</th>
                                <th>Select</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (inventoryItems && inventoryItems.length > 0) { %>
                                <% inventoryItems.forEach((item) => { %>
                                    <tr data-item-id="<%= item._id %>"
                                        data-item-name="<%= item.item %>"
                                        data-item-brand="<%= item.brand %>"
                                        data-item-catalog="<%= item.catalog || '' %>"
                                        data-item-quantity="<%= item.currentquantity %>">
                                        <td><%= item.item %></td>
                                        <td><%= item.brand %></td>
                                        <td><%= item.catalog || '' %></td>
                                        <td><%= item.currentquantity %></td>
                                        <td>
                                            <input type="checkbox" class="item-checkbox" data-item-id="<%= item._id %>">
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align: center;">No inventory items available</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <button id="addItemsBtn" class="add-items-btn">Add Items</button>
            </div>

            <!-- Right Side: Selected Items -->
            <div class="right-panel" data-panel="selected">
                <h3 class="panel-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    Items to Consume
                </h3>
                <div class="consume-header">
                    <button id="consumeBtn" class="consume-btn">Consume Selected</button>
                </div>

                <div id="selectedItemsContainer" class="selected-items-container">
                    <p class="empty-message">No items selected. Check items from the left and click "Add Items".</p>
                </div>
            </div>
        </div>
    </div>

    <script defer src="/consume.js"></script>
    <script defer src="/consumeCartIntegration.js"></script>
</body>
</html>
